#!/usr/bin/make -f
export PYBUILD_NAME=usbguard-desktop
export PYBUILD_TEST_ARGS=-q
export PYBUILD_TEST_PYTEST=1

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_install:
	dh_auto_install
	install -D -m 0755 helper/usbguard-desktop-bootstrap debian/usbguard-desktop/usr/libexec/usbguard-desktop-bootstrap
	set -e; for lang in ja ko zh_CN es; do \
	  install -d debian/usbguard-desktop/usr/share/locale/$$lang/LC_MESSAGES; \
	  msgfmt --check --check-format -o debian/usbguard-desktop/usr/share/locale/$$lang/LC_MESSAGES/usbguard-desktop.mo po/$$lang.po; \
	done
