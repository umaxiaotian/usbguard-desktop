#!/usr/bin/make -f
export PYBUILD_NAME=usbguard-desktop
export PYBUILD_TEST_ARGS=-q
export PYBUILD_TEST_PYTEST=1

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_install:
	dh_auto_install
	install -D -m 0755 helper/usbguard-desktop-bootstrap debian/usbguard-desktop/usr/libexec/usbguard-desktop-bootstrap
