msgid "USB Protection"
msgstr "USB 保护"
msgid "Cancel"
msgstr "取消"
msgid "Welcome to USB Protection"
msgstr "欢迎使用 USB 保护"
msgid "Before protection is enabled, all devices connected at that moment will be trusted. Unplug devices you do not trust, and keep your keyboard and mouse connected."
msgstr "启用保护时，当前连接的所有设备都将被信任。请拔下不信任的设备，并保持键盘和鼠标连接。"
msgid "Ready to protect this computer?"
msgstr "准备好保护这台计算机了吗？"
msgid "Enable USB Protection"
msgstr "启用 USB 保护"
msgid "Protection"
msgstr "保护"
msgid "On"
msgstr "开启"
msgid "USB Protection is currently disabled."
msgstr "USB 保护当前已禁用。"
msgid "New devices"
msgstr "新设备"
msgid "Ask — blocked until you allow them, unless a saved rule applies."
msgstr "询问 — 除非有已保存的规则，否则在您允许前保持阻止。"
msgid "Connected Devices"
msgstr "已连接的设备"
msgid "No connected USB devices"
msgstr "没有已连接的 USB 设备"
msgid "Rules"
msgstr "规则"
msgid "Saved Rules"
msgstr "已保存的规则"
msgid "Manage saved device decisions"
msgstr "管理已保存的设备决定"
msgid "Status"
msgstr "状态"
msgid "Access"
msgstr "访问权限"
msgid "Block"
msgstr "阻止"
msgid "Allow Once"
msgstr "允许一次"
msgid "Always Allow"
msgstr "始终允许"
msgid "Apply"
msgstr "应用"
msgid "Forget Rule"
msgstr "删除规则"
msgid "Forget this rule?"
msgstr "要删除此规则吗？"
msgid "Forget"
msgstr "删除"
msgid "Advanced"
msgstr "高级"
msgid "Device ID"
msgstr "设备 ID"
msgid "Serial"
msgstr "序列号"
msgid "Port"
msgstr "端口"
msgid "Interfaces"
msgstr "接口"
msgid "Fingerprint"
msgstr "指纹"
msgid "Allowed"
msgstr "已允许"
msgid "Blocked"
msgstr "已阻止"
msgid "Rejected"
msgstr "已拒绝"
msgid "Unknown"
msgstr "未知"
msgid "Unknown device"
msgstr "未知设备"
msgid "USB device"
msgstr "USB 设备"
msgid "USB storage"
msgstr "USB 存储设备"
msgid "USB hub"
msgstr "USB 集线器"
msgid "Keyboard, mouse or other input device"
msgstr "键盘、鼠标或其他输入设备"
msgid "Refresh"
msgstr "刷新"
msgid "Reconnect"
msgstr "重新连接"
msgid "Turn off USB Protection?"
msgstr "要关闭 USB 保护吗？"
msgid "Turn Off"
msgstr "关闭"
msgid "Protection updated"
msgstr "保护设置已更新"
msgid "New USB Device"
msgstr "新的 USB 设备"
msgid "USB Protection needs attention"
msgstr "USB 保护需要您处理"
msgid "Permission was not granted. You can try again."
msgstr "未授予权限。您可以重试。"
msgid "USBGuard is unavailable. Check that protection is enabled."
msgstr "USBGuard 不可用。请检查保护是否已启用。"
msgid "USBGuard restarted. Refresh and try again."
msgstr "USBGuard 已重新启动。请刷新后重试。"
msgid "{name}\n{kind}\nBlocked until you choose what to do."
msgstr "{name}\n{kind}\n在您选择操作前将保持阻止。"
msgid "Loading rules…"
msgstr "正在加载规则…"
msgid "No saved rules."
msgstr "没有已保存的规则。"
msgid "Custom matching rule"
msgstr "自定义匹配规则"
msgid "USBGuard rule"
msgstr "USBGuard 规则"
msgid "Remove saved decision"
msgstr "删除已保存的决定"
msgid "Could not load devices"
msgstr "无法加载设备"
msgid "USBGuard is not installed."
msgstr "未安装 USBGuard。"
msgid "Please reinstall USB Protection."
msgstr "请重新安装 USB 保护。"
msgid "USBGuard connection unavailable"
msgstr "USBGuard 连接不可用"
msgid "Protection service is running."
msgstr "保护服务正在运行。"
msgid "Unable to read service state"
msgstr "无法读取服务状态"
msgid "Unable to read the existing default policy."
msgstr "无法读取现有默认策略。"
msgid "Authorization was cancelled or the operation failed."
msgstr "授权已取消或操作失败。"
msgid "USB Protection did not respond in time. Please try again."
msgstr "USB 保护未及时响应。请重试。"
msgid "The device or rule is no longer available. Refresh and try again."
msgstr "设备或规则已不可用。请刷新后重试。"
msgid "The device changed or disappeared. Refresh and retry."
msgstr "设备已更改或断开。请刷新后重试。"
msgid "The rule changed. Refresh and try again."
msgstr "规则已更改。请刷新后重试。"
msgid "USB Protection restarted. Use the current device list."
msgstr "USB 保护已重新启动。请使用当前设备列表。"
msgid "Device notifications are disconnected. Open USB Protection to check status."
msgstr "设备通知已断开。请打开 USB 保护检查状态。"
msgid "A USB device reported invalid details. Open USB Protection to refresh."
msgstr "USB 设备报告了无效信息。请打开 USB 保护进行刷新。"
msgid "Custom rule"
msgstr "自定义规则"
msgid "Existing configuration: {value}. Your policy has been preserved."
msgstr "现有配置：{value}。您的策略已保留。"
msgid "Rules are evaluated in the order shown. Forgetting a rule does not change devices already connected."
msgstr "规则按显示顺序进行评估。删除规则不会改变已连接设备的状态。"
msgid "Future connections will follow the remaining rules. Currently connected devices keep their current access."
msgstr "以后的连接将遵循剩余规则。当前连接的设备将保持现有访问状态。"
msgid "Allow Once lasts for this connection. Existing persistent rules still apply on reconnect. Block affects this connection; forget an allow rule to stop trusting future connections."
msgstr "允许一次仅对当前连接有效。重新连接时仍会应用现有永久规则。阻止会影响当前连接；若不再信任未来连接，请删除允许规则。"
msgid "Block this device?"
msgstr "要阻止此设备吗？"
msgid "Blocking a keyboard, mouse, network adapter or USB hub may interrupt your access to this computer."
msgstr "阻止键盘、鼠标、网络适配器或 USB 集线器可能会中断您对这台计算机的访问。"
msgid "New USB devices will no longer be managed by USB Protection. Depending on your existing configuration, blocked devices may remain unavailable until you reconnect them or restart the computer."
msgstr "新的 USB 设备将不再由 USB 保护管理。根据现有配置，被阻止的设备可能在重新连接或重启计算机前仍不可用。"
msgid "Could not start notifications: {error}"
msgstr "无法启动通知：{error}"
msgid "USB Protection must run in your user session, not as root."
msgstr "USB 保护必须在您的用户会话中运行，不能以 root 身份运行。"
msgid "The notification agent must run in a user session, not as root."
msgstr "通知代理必须在用户会话中运行，不能以 root 身份运行。"
msgid "Invalid rule identifier in USBGuard response."
msgstr "USBGuard 响应中的规则标识符无效。"
msgid "Invalid rule in USBGuard response."
msgstr "USBGuard 响应中的规则无效。"
msgid "Empty rule in USBGuard response."
msgstr "USBGuard 响应中包含空规则。"
msgid "Malformed rule in USBGuard response."
msgstr "USBGuard 响应中的规则格式错误。"
msgid "Invalid USBGuard response."
msgstr "USBGuard 响应无效。"
msgid "Invalid USBGuard device list."
msgstr "USBGuard 设备列表无效。"
msgid "Invalid USBGuard list entry."
msgstr "USBGuard 列表项无效。"
msgid "Duplicate identifier in USBGuard response."
msgstr "USBGuard 响应中存在重复标识符。"
msgid "Invalid setting response from USBGuard."
msgstr "USBGuard 的设置响应无效。"
msgid "Invalid action response from USBGuard."
msgstr "USBGuard 的操作响应无效。"
msgid "Unknown device action."
msgstr "未知的设备操作。"
msgid "USBGuard is unavailable. Enable protection first."
msgstr "USBGuard 不可用。请先启用保护。"
msgid "Configuration must be a root-owned, non-writable regular file."
msgstr "配置必须是 root 所有且不可写的普通文件。"
msgid "The policy is empty. Protection was not started."
msgstr "策略为空。保护未启动。"
msgid "A policy already exists. It has not been changed."
msgstr "策略已存在，未进行更改。"
msgid "Generated policy failed ownership, permission or empty-file checks."
msgstr "生成的策略未通过所有权、权限或空文件检查。"
msgid "Existing custom USBGuard configuration needs administrator review."
msgstr "现有自定义 USBGuard 配置需要管理员检查。"
msgid "Additional rules already exist. They have not been changed."
msgstr "其他规则已存在，未进行更改。"
msgid "A custom policy location requires administrator review."
msgstr "自定义策略位置需要管理员检查。"
msgid "Expected one of: initialize, enable, disable, status"
msgstr "应为 initialize、enable、disable 或 status 之一"
msgid "Administrator authorization is required."
msgstr "需要管理员授权。"
msgid "The policy directory is not secure."
msgstr "策略目录不安全。"
msgid "Initial policy must trust currently connected devices."
msgstr "初始策略必须信任当前连接的设备。"
